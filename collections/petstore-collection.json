{
  "info": {
    "name": "Petstore CRUD API Regression",
    "description": "End-to-end CRUD regression for Swagger Petstore API v3. Flow: Create → Get → Update → Get → Delete → Verify deletion. A unique pet ID is generated for every collection run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create pet",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const petId = Date.now();",
              "pm.collectionVariables.set('petId', String(petId));",
              "pm.collectionVariables.set('petName', `qa-pet-${petId}`);",
              "pm.collectionVariables.set('updatedPetName', `qa-pet-updated-${petId}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 (documented successful response)', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type is JSON', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "});",
              "const json = pm.response.json();",
              "pm.test('Response matches the Pet response schema', function () {",
              "  pm.response.to.have.jsonSchema({",
              "    type: 'object',",
              "    required: ['id', 'name', 'photoUrls'],",
              "    properties: {",
              "      id: { type: 'integer' },",
              "      name: { type: 'string' },",
              "      photoUrls: { type: 'array', items: { type: 'string' } },",
              "      status: { type: 'string', enum: ['available', 'pending', 'sold'] }",
              "    }",
              "  });",
              "});",
              "pm.test('Created pet data matches the request', function () {",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('petId')));",
              "  pm.expect(json.name).to.eql(pm.collectionVariables.get('petName'));",
              "  pm.expect(json.photoUrls).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json.status).to.eql('available');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\"https://example.com/pet-photo.jpg\"],\n  \"status\": \"available\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet"
          ]
        },
        "description": "Creates a uniquely identified pet. The Pet schema requires name and photoUrls."
      }
    },
    {
      "name": "2. Get created pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Response matches the Pet response schema', function () {",
              "  pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'name', 'photoUrls'], properties: { id: { type: 'integer' }, name: { type: 'string' }, photoUrls: { type: 'array', items: { type: 'string' } }, status: { type: 'string', enum: ['available', 'pending', 'sold'] } } });",
              "});",
              "pm.test('Retrieved pet matches the created pet', function () {",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('petId')));",
              "  pm.expect(json.name).to.eql(pm.collectionVariables.get('petName'));",
              "  pm.expect(json.status).to.eql('available');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Retrieves the pet created in request 1."
      }
    },
    {
      "name": "3. Update pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Response matches the Pet response schema', function () {",
              "  pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'name', 'photoUrls'], properties: { id: { type: 'integer' }, name: { type: 'string' }, photoUrls: { type: 'array', items: { type: 'string' } }, status: { type: 'string', enum: ['available', 'pending', 'sold'] } } });",
              "});",
              "pm.test('Updated pet data is returned', function () {",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('petId')));",
              "  pm.expect(json.name).to.eql(pm.collectionVariables.get('updatedPetName'));",
              "  pm.expect(json.status).to.eql('pending');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"{{updatedPetName}}\",\n  \"photoUrls\": [\"https://example.com/pet-photo-updated.jpg\"],\n  \"status\": \"pending\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet"
          ]
        },
        "description": "Updates the pet using the documented PUT /pet operation."
      }
    },
    {
      "name": "4. Get updated pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Response matches the Pet response schema', function () {",
              "  pm.response.to.have.jsonSchema({ type: 'object', required: ['id', 'name', 'photoUrls'], properties: { id: { type: 'integer' }, name: { type: 'string' }, photoUrls: { type: 'array', items: { type: 'string' } }, status: { type: 'string', enum: ['available', 'pending', 'sold'] } } });",
              "});",
              "pm.test('GET returns the updated values', function () {",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('petId')));",
              "  pm.expect(json.name).to.eql(pm.collectionVariables.get('updatedPetName'));",
              "  pm.expect(json.photoUrls).to.include('https://example.com/pet-photo-updated.jpg');",
              "  pm.expect(json.status).to.eql('pending');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Confirms that the updated values are persisted."
      }
    },
    {
      "name": "5. Delete pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 (documented successful response)', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "Deletes the pet created by this collection run. OpenAPI documents HTTP 200 for successful deletion."
      }
    },
    {
      "name": "6. Verify deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted pet returns 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet",
            "{{petId}}"
          ]
        },
        "description": "OpenAPI documents HTTP 404 when the requested pet does not exist."
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://petstore3.swagger.io/api/v3",
      "type": "string"
    }
  ]
}
